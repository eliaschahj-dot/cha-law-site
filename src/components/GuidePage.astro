---
/* 안내 페이지 본문(절차 가이드·상황별 안내 공용, 상속·부동산 두 사이트). 분야 페이지(AreaPage)와 같은 틀을 쓴다. */
import Faq from './Faq.astro';
import { allAreas, areaPath } from '../data/areas';
import { getPublicColumns, related, postPath, fmtDate, tagPath } from '../data/posts';
import { site } from '../data/site';
import { guidesOf, guidePath, hubOf, siteMeta, type Guide } from '../data/guides';
interface Props { g: Guide }
const { g } = Astro.props;
const gs = g.site ?? 'in';
const m = siteMeta[gs];
const hub = hubOf(g);
const linked = allAreas.filter((a) => g.areas.includes(a.slug));
const cols = await getPublicColumns();
const posts = related(cols, g.tags, 6);
const others = guidesOf(gs).filter((x) => x.slug !== g.slug);
const sameKind = others.filter((x) => x.kind === g.kind);
const otherKind = others.filter((x) => x.kind !== g.kind);
---
<section class="area-hero">
  <div class="wrap">
    <div class="crumbs"><a href={m.home}>홈</a><span>/</span><a href={hub.href}>{hub.label}</a><span>/</span><span>{g.title}</span></div>
    <div class="gu" style="margin-top:18px">{g.eyebrow} <small>{fmtDate(g.updated)} 기준</small></div>
    <h1 style="font-size:clamp(28px,4vw,44px)">{g.title}</h1>
    <p class="lead">{g.lead}</p>
    <div class="cta-row" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:26px">
      <a class="btn btn-seal" href={`${m.contact}?topic=${encodeURIComponent(linked[0]?.name ?? m.field)}`}>상담 신청</a>
      <a class="btn btn-ghost" href={site.phoneHref}>변호사 직통 {site.phone}</a>
    </div>
  </div>
</section>
<div class="wrap area-body in">
  <div class="main">
    {g.deadlines.length > 0 && (
      <section>
        <h2>먼저 확인할 기한과 기준</h2>
        <div class="grid3">
          {g.deadlines.map((d) => <div class="card"><div class="k">{d.k}</div><p style="color:var(--ink);font-weight:600;font-size:15.5px">{d.v}</p></div>)}
        </div>
      </section>
    )}
    {g.sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        {s.p.map((t) => <p>{t}</p>)}
        {s.list && s.list.length > 0 && <ul class="situ">{s.list.map((i) => <li>{i}</li>)}</ul>}
      </section>
    ))}
    {g.faq.length > 0 && (
      <section>
        <h2>자주 묻는 질문</h2>
        <Faq items={g.faq} />
      </section>
    )}
    <p class="notice" style="margin-top:8px">이 안내는 {fmtDate(g.updated)} 기준의 일반적인 설명입니다. 법령과 실무는 바뀌고 사정마다 결론이 다르므로, 지금 상황에 적용되는 기준은 상담에서 확인합니다.</p>
    {linked.length > 0 && (
      <section>
        <h2>관련 업무 분야</h2>
        <div class="areas-grid">
          {linked.map((a) => <a class="area-card" href={areaPath(a)}><span class="n">{a.axis === 're' ? '부동산' : '상속'}</span><h3>{a.name}</h3><p>{a.short}</p></a>)}
        </div>
      </section>
    )}
    {posts.length > 0 && (
      <section>
        <h2>함께 읽는 글</h2>
        <div class="list">
          {posts.map((p) => <a href={postPath(p)}><time datetime={p.date}>{fmtDate(p.date)}</time><div><b>{p.title}</b><span class="chip">{p.section}</span></div></a>)}
        </div>
        <p style="margin-top:14px;display:flex;flex-wrap:wrap;gap:8px">
          {g.tags.map((t) => <a class="btn btn-paper btn-sm" href={tagPath(t)}>#{t} 글 모두 보기</a>)}
        </p>
      </section>
    )}
  </div>
  <aside class="side">
    <div class="card">
      <div class="k">상담 예약</div>
      <div class="big">{site.phone}</div>
      <p>{site.hours} · 변호사 직통. {site.reply}.</p>
      <a class="btn btn-seal" href={m.contact}>온라인 상담 신청</a>
    </div>
    {sameKind.length > 0 && (
      <div class="card">
        <div class="k">{hub.label}</div>
        <ul style="list-style:none;padding:0;display:grid;gap:8px">
          {sameKind.map((x) => <li><a href={guidePath(x)} style="text-decoration:none;font-weight:500">{x.title.split(':')[0]}</a></li>)}
        </ul>
      </div>
    )}
    {otherKind.length > 0 && (
      <div class="card">
        <div class="k">{hubOf(otherKind[0]).label}</div>
        <ul style="list-style:none;padding:0;display:grid;gap:8px">
          {otherKind.map((x) => <li><a href={guidePath(x)} style="text-decoration:none;font-weight:500">{x.title.split(':')[0]}</a></li>)}
        </ul>
      </div>
    )}
  </aside>
</div>
