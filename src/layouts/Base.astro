---
import '../styles/global.css';
import { site, nav, footerNav } from '../data/site';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object | object[];
  breadcrumbs?: { name: string; href?: string }[];
  rawTitle?: boolean;
}
const { title, description = site.description, jsonLd, breadcrumbs, rawTitle } = Astro.props;
const path = Astro.url.pathname;
const origin = Astro.site?.href ?? site.url; // astro.config의 site (SITE_URL 환경변수) 우선
const canonical = new URL(path, origin).href;
const fullTitle = rawTitle ? title : title === site.name ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;
const naverVerify = site.naverVerify || import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;
const googleVerify = site.googleVerify || import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const ogImage = new URL('/og.png', origin).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Attorney',
  name: `${site.name} (${site.firm})`,
  jobTitle: site.role,
  worksFor: { '@type': 'LegalService', name: site.firm },
  url: origin,
  telephone: site.phone,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: '테헤란로103길 10 길훈빌딩 2층', addressLocality: '강남구', addressRegion: '서울', addressCountry: 'KR' },
  areaServed: 'KR',
  knowsAbout: ['상속재산분할', '기여분', '유류분', '상속포기', '한정승인', '성년후견', '유언', '상속등기', '상속세'],
  award: '서울특별시장 표창(2023)',
  openingHours: ['Mo-Fr 10:00-18:00', 'Sa 10:00-14:00'],
};
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: `${site.name} | ${site.tagline}`, url: origin, inLanguage: 'ko' };
const crumbLd = breadcrumbs && breadcrumbs.length > 0 ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, ...(b.href ? { item: new URL(b.href, origin).href } : {}) })) } : null;
const ldItems = [orgLd, ...(path === '/' ? [siteLd] : []), ...(crumbLd ? [crumbLd] : []), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/')) || path === href + '/';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  {naverVerify && <meta name="naver-site-verification" content={naverVerify} />}
  {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="차형진 변호사 상속 칼럼" href="/rss.xml" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <meta name="theme-color" content="#F5F4EF" />
  <script is:inline>if (document.visibilityState === 'visible' && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');</script>
  <script is:inline>
  // 방문 통계(자체 수집): 경로·유입·기기·체류시간만 보낸다. 이름·IP 저장 없음. /stats 에 로그인한 브라우저(notrack 쿠키)는 제외.
  (function(){try{
    if(/(^|; )notrack=1/.test(document.cookie)||/^\/(admin|stats)/.test(location.pathname))return;
    var rnd=function(){return Math.random().toString(36).slice(2,10)+Date.now().toString(36)};
    var vid=localStorage.getItem('cv')||rnd();localStorage.setItem('cv',vid);
    var sid=sessionStorage.getItem('cs')||rnd();sessionStorage.setItem('cs',sid);
    var id=rnd();window.__hit={sid:sid,vid:vid};
    var send=function(o){var b=JSON.stringify(o);if(navigator.sendBeacon){navigator.sendBeacon('/api/hit',new Blob([b],{type:'text/plain'}))}else{fetch('/api/hit',{method:'POST',headers:{'Content-Type':'application/json'},body:b,keepalive:true}).catch(function(){})}};
    send({type:'view',id:id,sid:sid,vid:vid,path:location.pathname,ref:document.referrer||'',title:document.title,w:screen.width,q:location.search.slice(0,120)});
    var active=0,last=Date.now(),vis=document.visibilityState==='visible',sent=0;
    var tick=function(){if(vis)active+=Date.now()-last;last=Date.now()};
    var leave=function(){tick();var d=Math.round(active/1000);if(d>sent){sent=d;send({type:'leave',id:id,sid:sid,dur:d})}};
    document.addEventListener('visibilitychange',function(){tick();vis=document.visibilityState==='visible';if(!vis)leave()});
    addEventListener('pagehide',leave);
    setInterval(function(){if(vis)leave()},30000);
  }catch(e){}})();
  </script>
  {ldItems.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <nav class="nav" aria-label="주요 메뉴">
    <div class="navin">
      <a class="brand" href="/" aria-label={`${site.name} 홈`}>
        <Mark />
        <b>차형진<span>변호사</span></b>
        <i>상속 · {site.firm}</i>
      </a>
      <div class="menu">
        {nav.map((n) => <a href={n.href} class={isCurrent(n.href) ? 'cur' : undefined} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <a class="on" href="/contact">상담 예약</a>
      </div>
      <a class="navtel" href={site.phoneHref}>{site.phone}</a>
    </div>
  </nav>
  <div class="mobcta">
    <a class="m1" href={site.phoneHref}>변호사 직통</a>
    <a class="m2" href="/contact">상담 예약</a>
  </div>

  <main id="top">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="fbar"></div>
      <div class="fmenu">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/contact">상담 예약</a>
        {footerNav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={site.blog} target="_blank" rel="noopener">네이버 블로그</a>
        <a href="https://beyullaw.com" target="_blank" rel="noopener">법무법인 베율</a>
        <a href="/privacy">개인정보처리방침</a>
      </div>
      <div class="finfo">
        <b>{site.firm}</b> · 파트너 변호사 차형진<br />
        {site.address} ({site.transit})<br />
        변호사 직통 {site.phone} · {site.email}<br />
        {site.hours} · {site.closed}
      </div>
      <div class="disc">
        광고 주체: 변호사 차형진 ({site.firm} · {site.bar}) · 이 페이지의 내용은 상속에 관한 일반적인 정보이며, 개별 사건에 대한 법률 자문이 아닙니다. 사건마다 사실관계와 증거, 상속인 사이의 관계에 따라 판단과 결과가 달라질 수 있으며 특정한 결과를 약속하거나 보장하지 않습니다. 기한과 비율은 민법 등 현행 법령을 기준으로 정리했습니다. 상담 내용은 변호사법에 따라 비밀이 유지됩니다. © 2026 차형진 변호사
      </div>
    </div>
  </footer>

  <script>
    // 스크롤 등장 효과: 화면에 들어오는 블록을 순서대로 띄운다 (html.anim 이 없으면 CSS가 적용되지 않아 그대로 보인다)
    if (document.documentElement.classList.contains('anim') && 'IntersectionObserver' in window) {
      const sel = '.sec-head, .shead, .principle, .press, .faq, .contact > *, .area-card, .card, .steps li, .situ li, .list > a, .filters, .grid2 > *, .grid3 > *, .area-hero .wrap > *, .case, .read, .fee, .kgroup, .cred, .declgrid > *, .a-card, .cvbox, .resc, .formwrap, .contact2 > *';
      const els = Array.from(document.querySelectorAll(sel)) as HTMLElement[];
      const vh = window.innerHeight;
      const show = (el: HTMLElement) => { if (el.classList.contains('in')) return; el.classList.add('in'); setTimeout(() => el.classList.add('settled'), 1400); };
      const ro = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { show(e.target as HTMLElement); ro.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach((el) => {
        if (el.classList.contains('rv')) return;
        const i = Array.from(el.parentElement?.children ?? []).indexOf(el);
        el.style.transitionDelay = `${(i % 5) * 70}ms`;
        el.classList.add('rv');
        if (el.getBoundingClientRect().top < vh * 0.92) show(el);
        else ro.observe(el);
      });
      // 안전장치: 관찰이 실패해도 화면 안에 있는 블록은 2.5초 뒤 보이게, 스크롤 때마다 다시 확인
      const sweep = () => els.forEach((el) => { if (el.getBoundingClientRect().top < window.innerHeight) show(el); });
      setTimeout(sweep, 2500);
      window.addEventListener('scroll', sweep, { passive: true });
    }
  </script>
</body>
</html>
