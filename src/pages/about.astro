---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { bio, activities, site } from '../data/site';
import fs from 'node:fs';
const hasPhoto = fs.existsSync(new URL('../../public/profile.jpg', import.meta.url));
const ld = {
  '@context': 'https://schema.org', '@type': 'Person', name: '차형진', jobTitle: '변호사', worksFor: { '@type': 'Organization', name: site.firm },
  alumniOf: ['한동대학교', '카이스트 경영대학원'], knowsAbout: ['부동산', '상속', '성년후견', '전세사기'], url: site.url + '/about',
};
---
<Base title="변호사 소개" description="한동대 건축학·법학 복수전공, 카이스트 사회적기업가 MBA. 서울시 공익변호사, 서울특별시장 표창, 대한변협 성년후견회 전문위원. 법무법인 베율 파트너 변호사 차형진." jsonLd={ld}>
  <section class="area-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">홈</a><span>/</span><span>변호사 소개</span></div>
      <div class="gu" style="margin-top:18px">표제부 <small>변호사</small></div>
      <h1>차형진 변호사</h1>
      <p class="lead">"{bio.quote}"</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap profile">
      {hasPhoto ? <img class="photo-img" src="/profile.jpg" alt="차형진 변호사 프로필 사진" width="800" height="1000" /> : <div class="photo">프로필 사진<br />(public/profile.jpg 에 넣으면 표시됩니다)</div>}
      <div>
        <div class="prose" style="color:var(--ink);font-size:17px">
          <p>{bio.intro}</p>
          <p>건축학을 먼저 공부했기 때문에 도면과 시방서, 하자 보고서를 변호사가 직접 읽습니다. 분양·재개발·공사대금 사건에서 감정 결과를 그대로 받아들이지 않고 다시 따져 보는 이유입니다.</p>
          <p>2019년 로펌에서 만난 치매 할머니의 사연이 지금의 일하는 방식을 만들었습니다. 형제 한 명이 어머니 인감으로 아파트를 팔고, 다른 형제는 어머니를 데려갔습니다. 변호사라면 후견인 지정 방법을 안내하면 될 일이었지만, "미리 막을 수 있었다"는 생각이 떠나지 않았습니다. 그래서 치매 전에 뜻을 남기는 서비스와 계약 전 과정을 기록하는 화상 계약 서비스를 만드는 리걸테크 회사를 세웠고, 서울시 공익변호사로 활동하며 시민 법률 복지에 기여한 공로로 서울특별시장 표창을 받았습니다.</p>
          <p>지금은 법무법인 베율의 파트너 변호사로, 변호사·세무사·회계사가 한 팀인 구조 안에서 부동산과 상속 사건을 맡습니다. 분쟁이 되기 전의 설계와 분쟁이 된 뒤의 해결을 같은 무게로 다룹니다.</p>
        </div>
        <div class="cv">
          <div><h4>학력</h4><ul>{bio.education.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>경력</h4><ul>{bio.career.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>활동</h4><ul>{bio.activity.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>수상 · 강의</h4><ul>{bio.awards.map((x) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec band-paper">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">일하는 방식</div>
        <h2>세 가지 약속</h2>
      </div>
      <div class="grid3">
        <div class="card"><div class="k">하나</div><h3>변호사가 직접</h3><p>첫 전화부터 서면 작성, 재판 출석까지 변호사가 직접 합니다. 사무장이 상담하거나 예약만 잡는 방식이 아닙니다.</p></div>
        <div class="card"><div class="k">둘</div><h3>정해진 건수만</h3><p>집중해서 다룰 수 있는 사건 수를 정해 두고 그 안에서만 맡습니다. 사건마다 변호사가 기록을 처음부터 끝까지 읽습니다.</p></div>
        <div class="card"><div class="k">셋</div><h3>숫자로 말합니다</h3><p>상담에서 예상 기간과 총비용, 현실적인 전망을 숫자로 말씀드립니다. 듣기 좋은 말보다 결정에 필요한 말을 드립니다.</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">활동</div>
        <h2>기록으로 남은 활동</h2>
      </div>
      <div class="list">
        {activities.map((a) => <div style="display:grid;grid-template-columns:96px 1fr;gap:16px;padding:16px 0;border-top:1px solid var(--rule-2)"><span style="font-size:12px;letter-spacing:.1em;color:var(--ink-3);font-weight:600">{a.k}</span><div><b style="font-weight:600">{a.v}</b>{a.s && <span style="display:block;font-size:13.5px;color:var(--ink-2)">{a.s}</span>}</div></div>)}
      </div>
      <p style="margin-top:22px"><a class="btn btn-ghost" href="/press">언론 보도 보기</a></p>
    </div>
  </section>
  <CtaBand />
</Base>
