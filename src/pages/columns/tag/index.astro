---
/* 주제별 칼럼 모음 허브: 태그마다 글 수와 한 줄 설명. 검색 노출용 내부 링크 허브. */
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getPublicColumns, tagPath } from '../../../data/posts';
import { tagSeo, TAG_ORDER } from '../../../data/seo';
import { allAreas } from '../../../data/areas';

const cols = await getPublicColumns();
const counts = new Map<string, number>();
for (const p of cols) for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const ordered = [...TAG_ORDER.filter((t) => counts.has(t)), ...[...counts.keys()].filter((t) => !TAG_ORDER.includes(t)).sort()];
const main = ordered.filter((t) => tagSeo[t]?.group === '상속');
const rest = ordered.filter((t) => tagSeo[t]?.group !== '상속');
const areas = allAreas;
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: '상속 칼럼 주제별 모음', hasPart: main.map((t) => ({ '@type': 'WebPage', name: tagSeo[t]?.title ?? t, url: new URL(tagPath(t), Astro.site).href })) };
---
<Base title="상속 칼럼 주제별 모음 | 유류분·상속포기·상속재산분할·유언·성년후견" rawTitle description={`유류분, 상속재산분할, 상속포기·한정승인, 유언, 성년후견, 상속세, 상속등기까지 주제별로 모은 칼럼 ${cols.length}편. 상속 전문 변호사 차형진.`} jsonLd={ld} breadcrumbs={[{ name: '홈', href: '/' }, { name: '칼럼', href: '/columns' }, { name: '주제별 모음' }]}>
  <section class="area-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">홈</a><span>/</span><a href="/columns">칼럼</a><span>/</span><span>주제별 모음</span></div>
      <div class="gu" style="margin-top:18px">주제별 모음</div>
      <h1>궁금한 주제부터 골라 읽기</h1>
      <p class="lead">같은 질문에 답해 온 글을 주제별로 묶었습니다. 주제마다 관련 업무 분야 페이지로 이어집니다.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <h2 style="font-size:22px;margin:0 0 14px">상속</h2>
      <div class="grid3">
        {main.map((t) => { const s = tagSeo[t]; const linked = areas.filter((a) => a.tags.includes(t)); return (
          <a class="card" href={tagPath(t)} style="text-decoration:none">
            <div class="k">{t} · {counts.get(t)}편</div>
            <h3 style="font-size:17px;margin:4px 0 6px">{s?.title ?? `${t} 칼럼 모음`}</h3>
            <p style="font-size:14px">{s?.desc}</p>
            {linked.length > 0 && <p style="color:var(--accent);font-weight:600;font-size:13px">관련 분야: {linked.map((a) => a.name).join(' · ')}</p>}
          </a>
        ); })}
      </div>
      {rest.length > 0 && (
        <>
          <h2 style="font-size:22px;margin:34px 0 14px">부동산 <small style="font-size:14px;color:var(--ink-3);font-weight:600">— <a href="/real-estate">부동산 전문 홈페이지</a></small></h2>
          <div class="grid3">
            {rest.map((t) => { const s = tagSeo[t]; const linked = areas.filter((a) => a.tags.includes(t)); return (
              <a class="card" href={tagPath(t)} style="text-decoration:none">
                <div class="k">{t} · {counts.get(t)}편</div>
                <h3 style="font-size:17px;margin:4px 0 6px">{s?.title ?? `${t} 칼럼 모음`}</h3>
                <p style="font-size:14px">{s?.desc}</p>
                {linked.length > 0 && <p style="color:var(--accent);font-weight:600;font-size:13px">관련 분야: {linked.map((a) => a.name).join(' · ')}</p>}
              </a>
            ); })}
          </div>
        </>
      )}
      <p class="src" style="margin-top:26px">분야별 안내는 <a href="/inheritance">상속 업무 분야</a>에서, 상황별 안내는 <a href="/situations">이런 상황이라면</a>에서 보실 수 있습니다.</p>
    </div>
  </section>
  <CtaBand />
</Base>
