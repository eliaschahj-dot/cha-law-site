---
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { publicPosts, sections, postPath, fmtDate } from '../../../data/posts';

export function getStaticPaths() {
  return sections.map((s) => ({ params: { section: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const list = publicPosts.filter((p) => p.section === s.name);
const counts = Object.fromEntries(sections.map((x) => [x.slug, publicPosts.filter((p) => p.section === x.name).length]));
---
<Base title={s.label} description={`${s.desc}. 차형진 변호사의 ${s.label} ${list.length}편.`}>
  <section class="area-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">홈</a><span>/</span><a href="/columns">칼럼 · 꿀팁</a><span>/</span><span>{s.label}</span></div>
      <div class="gu" style="margin-top:18px">{s.label}</div>
      <h1>{s.name === '꿀팁' ? '계약 전에 확인할 것들' : `${s.name} 칼럼`}</h1>
      <p class="lead">{s.desc}. 모두 {list.length}편.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="filters">
        <a href="/columns">전체</a>
        {sections.map((x) => <a href={`/columns/topic/${x.slug}`} aria-current={x.slug === s.slug ? 'page' : undefined}>{x.label} <span style="opacity:.6">{counts[x.slug]}</span></a>)}
      </div>
      <div class="list">
        {list.map((p) => (
          <a href={postPath(p)}>
            <time datetime={p.date}>{fmtDate(p.date)}</time>
            <div><b>{p.title}</b>{p.excerpt && <span>{p.excerpt}</span>}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
