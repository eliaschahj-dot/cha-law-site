---
/* 상속 FAQ 모음: 홈·분야별·비용 FAQ를 한 페이지에. 검색 노출용(FAQPage 구조화 데이터). */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faq as homeFaq, feeFaq } from '../data/site';
import { areas, areaPath } from '../data/areas';

const groups = [
  { id: 'general', name: '상담 · 일반', items: homeFaq },
  ...areas.map((a) => ({ id: a.slug, name: a.name, items: a.faq, href: areaPath(a) })),
  { id: 'fees', name: '비용', items: feeFaq, href: '/fees' },
];
const all = groups.flatMap((g) => g.items);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="상속 자주 묻는 질문 모음" description={`상속포기 기한, 유류분 계산, 기여분 인정, 성년후견, 유언 효력, 상속세, 변호사 비용까지 상담에서 가장 많이 받는 질문 ${all.length}개에 상속 전문 변호사 차형진이 답합니다.`} jsonLd={ld} breadcrumbs={[{ name: '홈', href: '/' }, { name: '자주 묻는 질문' }]}>
  <section class="area-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">홈</a><span>/</span><span>자주 묻는 질문</span></div>
      <div class="gu" style="margin-top:18px">FAQ <small>{all.length}개</small></div>
      <h1>상속, 상담에서 가장 많이 받는 질문</h1>
      <p class="lead">기한이 걸린 질문부터 보세요. 상속포기·한정승인은 3개월, 유류분은 안 날부터 1년입니다. 여기 없는 질문은 상담 신청서에 그대로 적어 주시면 변호사가 직접 답합니다.</p>
      <div class="docs" style="margin-top:22px">
        {groups.map((g) => <li><a href={`#${g.id}`} style="text-decoration:none">{g.name}</a></li>)}
      </div>
    </div>
  </section>
  <div class="wrap area-body in">
    <div class="main">
      {groups.map((g) => (
        <section id={g.id}>
          <h2>{g.name}</h2>
          <Faq items={g.items} />
          {g.href && <p style="margin-top:14px"><a href={g.href} style="font-weight:700">{g.name} 자세히 보기 →</a></p>}
        </section>
      ))}
    </div>
    <aside class="side">
      <div class="card">
        <div class="k">상담 예약</div>
        <p>여기 없는 질문은 신청서에 그대로 적어 주세요. 24시간 안에 변호사가 직접 연락드립니다.</p>
        <a class="btn btn-seal" href="/contact">온라인 상담 신청</a>
      </div>
      <div class="card">
        <div class="k">용어가 어려우면</div>
        <p>유류분, 기여분, 특별수익, 한정승인 같은 말을 쉽게 풀어 두었습니다.</p>
        <a href="/glossary" style="font-weight:700">상속 용어 사전 →</a>
      </div>
    </aside>
  </div>
  <CtaBand />
</Base>
