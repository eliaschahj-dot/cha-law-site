---
/* 지역 랜딩: 강남·삼성역 상속변호사 (검색 노출용). 사무실 안내·관할·상담 흐름. */
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { areas, areaPath } from '../data/areas';

const faq = [
  { q: '주차가 되나요?', a: '길훈빌딩 주차장을 이용하실 수 있습니다. 방문 전에 알려주시면 안내드립니다. 지하철은 2호선 삼성역 8번 출구에서 도보 5분입니다.' },
  { q: '저녁이나 주말에도 상담이 되나요?', a: '평일 10시~18시, 토요일 10시~14시에 상담합니다. 직장 때문에 어려우시면 전화나 이메일로 먼저 상황을 보내주세요. 시간을 맞춰 전화 상담을 잡아 드립니다.' },
  { q: '서울이 아닌 지방 사건도 맡으시나요?', a: '상속재산분할 심판은 돌아가신 분의 마지막 주소지 가정법원이 관할이라 전국 어디든 사건이 생깁니다. 수도권은 물론 지방 법원 사건도 수행하며, 첫 상담은 전화·화상으로 진행할 수 있습니다.' },
  { q: '첫 상담에 무엇을 준비해야 하나요?', a: '가족관계증명서, 재산 목록(등기부·잔고), 문제가 된 유언장·계약서, 형제와 주고받은 메시지, 그리고 지금까지의 경과를 시간순으로 적은 메모 한 장이면 충분합니다. 없으면 없는 대로 오셔도 됩니다.' },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'LegalService', name: `${site.name} (${site.firm})`, url: site.url + '/gangnam', telephone: site.phone, email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: '테헤란로103길 10 길훈빌딩 2층', addressLocality: '강남구', addressRegion: '서울', postalCode: '06173', addressCountry: 'KR' },
    areaServed: ['서울', '경기', '인천', '대한민국'], openingHours: ['Mo-Fr 10:00-18:00', 'Sa 10:00-14:00'], priceRange: '상담에서 안내', knowsAbout: ['상속재산분할', '유류분', '상속포기', '한정승인', '성년후견', '유언'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="강남 상속변호사 · 삼성역 법무법인 베율" description="강남 삼성역 8번 출구 도보 5분, 법무법인 베율 부대표 차형진 변호사. 상속재산분할·유류분·상속포기·성년후견·유언 상담. 서울가정법원·수도권·지방 사건 수행, 변호사가 직접 상담합니다." jsonLd={ld} breadcrumbs={[{ name: '홈', href: '/' }, { name: '강남 상속변호사' }]}>
  <section class="area-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">홈</a><span>/</span><span>강남 상속변호사</span></div>
      <div class="gu" style="margin-top:18px">오시는 길 <small>강남 · 삼성역</small></div>
      <h1>강남 상속변호사, 삼성역에서 만납니다</h1>
      <p class="lead">법무법인 베율 사무실은 삼성역 8번 출구에서 걸어서 5분입니다. 상속 사건만 맡는 차형진 변호사가 첫 상담부터 재판까지 직접 합니다. 서울가정법원 사건은 물론 수도권과 지방 법원 사건도 수행합니다.</p>
      <div class="cta-row" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:26px">
        <a class="btn btn-seal" href="/contact">상담 예약</a>
        <a class="btn btn-ghost" href={site.phoneHref}>변호사 직통 {site.phone}</a>
      </div>
    </div>
  </section>
  <div class="wrap area-body in">
    <div class="main">
      <section>
        <h2>사무실</h2>
        <div class="grid3">
          <div class="card"><div class="k">주소</div><p style="color:var(--ink);font-weight:600">{site.address}</p><p><a href="https://map.naver.com/v5/search/%EC%84%9C%EC%9A%B8%20%EA%B0%95%EB%82%A8%EA%B5%AC%20%ED%85%8C%ED%97%A4%EB%9E%80%EB%A1%9C103%EA%B8%B8%2010" target="_blank" rel="noopener">네이버 지도에서 보기 →</a></p></div>
          <div class="card"><div class="k">교통</div><p style="color:var(--ink);font-weight:600">{site.transit}</p><p>{site.parking}</p></div>
          <div class="card"><div class="k">상담 시간</div><p style="color:var(--ink);font-weight:600">{site.hours}</p><p>{site.closed} · {site.reply}</p></div>
        </div>
      </section>
      <section>
        <h2>관할 법원 안내</h2>
        <ul class="situ">
          <li><b>상속재산분할 · 기여분 심판</b> — 돌아가신 분의 마지막 주소지를 관할하는 가정법원(서울이면 서울가정법원)에 청구합니다.</li>
          <li><b>상속포기 · 한정승인</b> — 같은 가정법원에 상속이 시작된 것을 안 날부터 3개월 안에 신고합니다.</li>
          <li><b>유류분 반환 청구</b> — 가사 사건이 아니라 민사 소송이며, 상대방 주소지나 부동산 소재지 지방법원에 냅니다.</li>
          <li><b>성년후견 개시</b> — 사건본인(부모님)의 주소지 가정법원에 청구합니다.</li>
        </ul>
      </section>
      <section>
        <h2>상담은 이렇게 진행됩니다</h2>
        <ol class="steps">
          <li><div><b>전화·온라인 신청</b><span>상황을 간단히 적어 보내시면 24시간 안에 변호사가 직접 연락드립니다.</span></div></li>
          <li><div><b>첫 상담 (사무실 · 전화 · 화상)</b><span>기한이 있는 일부터 확인하고, 사건의 방향과 총 예상 비용을 숫자로 말씀드립니다.</span></div></li>
          <li><div><b>수임 · 자료 수집</b><span>금융기관·관공서 사실조회로 숨은 재산과 증여 흐름을 찾습니다.</span></div></li>
          <li><div><b>협상 또는 심판·소송</b><span>합의가 더 나은 길이면 먼저 제안하고, 아니면 끝까지 갑니다.</span></div></li>
        </ol>
      </section>
      <section>
        <h2>맡는 상속 사건</h2>
        <div class="areas-grid">
          {areas.map((a) => <a class="area-card" href={areaPath(a)}><span class="n">상속</span><h3>{a.name}</h3><p>{a.short}</p></a>)}
        </div>
      </section>
      <section>
        <h2>자주 묻는 질문</h2>
        <Faq items={faq} />
      </section>
    </div>
    <aside class="side">
      <div class="card">
        <div class="k">상담 예약</div>
        <div class="big">{site.phone}</div>
        <p>{site.hours} · 변호사 직통</p>
        <a class="btn btn-seal" href="/contact">온라인 상담 신청</a>
      </div>
      <div class="card">
        <div class="k">이메일</div>
        <p style="color:var(--ink);font-weight:600">{site.email}</p>
        <p>사진과 서류를 첨부해 보내시면 검토 후 연락드립니다.</p>
      </div>
    </aside>
  </div>
  <CtaBand />
</Base>
