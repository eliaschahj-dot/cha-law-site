const faq = [
  ['상담은 변호사가 직접 하나요?', '네. 남겨주신 내용은 사무실 직원을 거치지 않고 제가 직접 읽고, 판단하고, 답합니다. 신청 후 24시간 안에 변호사가 직접 연락드립니다.'],
  ['돌아가신 지 3개월이 다 되어 갑니다. 상속포기를 해야 하나요?', '상속포기와 한정승인은 상속이 시작된 것을 안 날부터 3개월 안에 가정법원에 신고해야 합니다. 빚이 재산보다 많은지 확실하지 않다면 한정승인을 먼저 검토하고, 포기하면 다음 순위 가족에게 빚이 넘어갈 수 있다는 점도 함께 봐야 합니다. 기한이 얼마 남지 않았다면 바로 연락 주세요.'],
  ['형제 한 명이 생전에 아파트를 받았습니다. 돌려받을 수 있나요?', '생전 증여도 유류분 계산에 들어갑니다. 유류분 반환은 상속이 시작된 사실과 반환해야 할 증여를 안 날부터 1년, 상속이 시작된 날부터 10년 안에 청구해야 합니다. 상속재산분할에서는 특별수익으로 반영해 내 몫을 다시 계산할 수도 있습니다.'],
  ['부모님이 치매 진단을 받으셨는데 재산 문제가 걱정됩니다.', '성년후견을 개시해 후견인을 정하면 재산이 마음대로 처분되는 것을 막을 수 있습니다. 판단 능력이 남아 계실 때라면 유언이나 신탁, 내 뜻 전달서로 미리 뜻을 남기는 방법도 있습니다.'],
  ['상속세까지 같이 봐주시나요?', '법무법인 베율의 세무사·회계사와 한 팀으로, 나누는 방법이 세금에 미치는 영향까지 함께 봅니다. 상속세 신고 기한은 상속이 시작된 달의 말일부터 6개월입니다.'],
  ['형제가 부모님 재산을 미리 빼돌린 것 같은데 증거가 없습니다.', '지금 증거가 없어도 괜찮습니다. 심판이나 소송 절차에서 금융기관과 관공서에 사실조회를 신청하면 계좌 거래 내역과 부동산 이전 기록을 확인할 수 있습니다. 어느 은행, 어느 시기가 의심되는지 정도만 알려주셔도 출발할 수 있습니다.'],
];
