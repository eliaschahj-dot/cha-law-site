  { cat: '청구 · 유류분', stamp: '유류분을 돌려받습니다', stampSub: '한 사람에게 다 갔을 때', k: '먼저 청구하는 쪽', chip: '유류분 반환 청구', h: '유언으로 재산이 한 형제에게 전부 갔다면', from: '남긴 뜻대로라면<br />내 몫은 0원', to: '법정상속분의 절반까지<br />반환 청구', desc: '유언이나 생전 증여로 재산이 한쪽에 몰려도, 자녀와 배우자는 법정상속분의 절반을 유류분으로 돌려받을 수 있습니다. 안 날부터 1년, 상속이 시작된 날부터 10년이라는 기한이 있어 서둘러야 합니다.' },
  { no: true, cat: '방어 · 특별수익', stamp: '내 몫을 지켜냅니다', stampSub: '특별수익 공격을 받을 때', k: '소장을 받은 쪽', chip: '특별수익 방어', h: '“너, 예전에 돈 받아 갔잖아” 소장이 왔다면', from: '학비·전세 자금·생활비<br />모두 미리 받은 상속분?', to: '부양 차원의<br />지원이었음을 입증', desc: '상대방이 과거에 받은 돈을 전부 특별수익이라 주장하며 내 몫을 깎으려 할 때입니다. 단순한 생활비나 부양 차원의 지원이었음을 입증해, 깎일 뻔한 상속분을 그대로 지켜냅니다.' },
  { no: true, cat: '방어 · 기여분 반박', stamp: '부풀린 기여도를 걷어냅니다', stampSub: '과도한 기여분 주장', k: '소장을 받은 쪽', chip: '기여분 반박', h: '“내가 다 모셨으니 내 몫이다” 주장이 나왔다면', from: '있지도 않은<br />기여도 주장', to: '‘특별’하지 않았음을<br />조목조목 반박', desc: '다른 형제가 기여를 부풀려 상속재산 대부분을 가져가려 할 때입니다. 그 기여가 법이 말하는 특별한 부양이 아니었음을 하나씩 짚어, 정당한 내 몫을 되찾습니다.' },
  { cat: '분할 이후 · 등기·세금', stamp: '새는 돈까지 챙깁니다', stampSub: '받은 뒤의 손실을 막습니다', k: '분할을 마친 뒤', chip: '상속세 · 상속등기', h: '받고 나서 세금으로 새지 않도록', from: '분할 따로,<br />세금 따로', to: '나누는 방법부터<br />세금까지 함께 설계', desc: '같은 재산도 누가 얼마를 받느냐에 따라 상속세가 달라집니다. 법무법인 베율의 세무사·회계사와 한 팀으로 분할 방식과 신고, 상속등기까지 끝까지 챙겨 실제로 손에 남는 몫을 키웁니다.' },
];

// 맡는 일: 떠나기 전(설계) / 떠난 뒤(분쟁). page = 상세 랜딩 페이지, topic = 상담 신청서 미리 선택
