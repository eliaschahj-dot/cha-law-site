---
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, trust, bio, press, pressOutlets, faq } from '../data/site';
import { byAxis, axisMeta, areaPath } from '../data/areas';
import { getPublicColumns, postPath, fmtDate } from '../data/posts';
import fs from 'node:fs';

const hasPhoto = fs.existsSync(new URL('../../public/profile.jpg', import.meta.url));
const re = byAxis('re');
const inh = byAxis('in');
const picks = press.filter((p) => p.pick);
const cols = await getPublicColumns();
const latest = (name: string) => cols.find((p) => p.section === name && p.full && p.excerpt);
const homePosts = [latest('상속'), latest('부동산'), latest('꿀팁')].filter(Boolean);

const rail = [
  { id: 'pyoje', label: '표제부' },
  { id: 'gapgu', label: '갑구 · 분야' },
  { id: 'eulgu', label: '을구 · 방식' },
  { id: 'about', label: '변호사' },
  { id: 'fees', label: '비용' },
  { id: 'columns', label: '칼럼' },
  { id: 'press', label: '언론' },
  { id: 'faq', label: '문답' },
  { id: 'contact', label: '상담' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={site.name} jsonLd={faqLd} rail={rail}>

  <!-- 히어로 -->
  <section class="hero">
    <div class="vertical" aria-hidden="true">부동산 · 상속 변호사 차형진</div>
    <div class="wrap">
      <div>
        <div class="eyebrow rise">부동산 · 상속 전문 변호사 차형진</div>
        <h1 class="rise rise-2" data-type>집은 사고파는 것이 아니라,<br />지키고 <em class="brush">물려주는<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path pathLength="100" d="M3 13 C 45 4, 110 19, 197 8" /></svg></em> 것입니다.</h1>
      </div>
      <div class="hero-grid">
        <div>
          <p class="lead rise rise-3">전세보증금과 분양·매매 분쟁부터 유언·유류분·상속재산분할까지. 분쟁이 되기 전에 설계하고, 분쟁이 되면 끝까지 함께합니다. 상담도 재판도 변호사가 직접 합니다.</p>
          <div class="cta rise rise-3">
            <a class="btn btn-seal" href="/contact">상담 예약하기</a>
            <a class="btn btn-ghost" href="#gapgu">어떤 일로 오셨나요?</a>
          </div>
          <p class="direct rise rise-3">변호사 직통 <b>{site.phone}</b> · {site.reply}</p>
        </div>
        <Ledger />
      </div>
    </div>
  </section>

  <!-- 표제부 -->
  <section class="pyoje" id="pyoje" aria-label="표제부">
    <div class="wrap">
      {trust.map((t) => <div><span>{t.k}</span><b>{t.v}{t.n !== undefined && <> <i data-count={t.n} style="font-style:normal;color:var(--seal)">{t.n}</i>{t.unit}</>}</b>{t.s}</div>)}
    </div>
  </section>

  <!-- 갑구: 업무 분야 -->
  <section class="sec" id="gapgu">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">갑구 <small>업무 분야</small></div>
        <h2>어떤 일로 오셨나요?</h2>
        <p>부동산 분쟁의 끝에는 상속이 있고, 상속 분쟁의 한가운데에는 부동산이 있습니다. 두 분야를 한 사람이 맡는 이유입니다. 순위를 눌러 상황을 확인해 보세요.</p>
      </div>
      <div class="axes">
        {([['re', re], ['in', inh]] as const).map(([axis, list]) => (
          <article class={`axis ${axis}`}>
            <div class="axis-head">
              <div class="n">{axisMeta[axis].gu}</div>
              <h3>{axisMeta[axis].name}</h3>
              <p>{axisMeta[axis].sub}</p>
            </div>
            <div class="rows">
              {list.map((a, i) => (
                <details>
                  <summary><i>{i + 1}</i><span style="color:var(--ink);font-weight:600;font-size:15.5px">{a.name}</span><span>{a.short}</span></summary>
                  <div class="body">
                    <p>{a.lead}</p>
                    <p>{a.situations[0]}. {a.situations[1]}.</p>
                    <p><a href={areaPath(a)}>{a.name} 자세히 보기 →</a></p>
                  </div>
                </details>
              ))}
            </div>
            <div class="axis-foot"><a class="btn btn-paper" href={axisMeta[axis].base}>{axisMeta[axis].name} 전체 보기</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 을구: 일하는 방식 -->
  <section class="sec band-ink" id="eulgu">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">을구 <small>일하는 방식</small></div>
        <h2>분쟁이 되기 전에, 그리고 분쟁이 된 뒤에</h2>
        <p>변호사는 대개 일이 터진 뒤에 만납니다. 저는 일이 터지기 전의 설계를 같은 무게로 봅니다. 계약서 한 장, 유언장 한 장이 소송 몇 년을 줄입니다.</p>
      </div>
      <div class="phases">
        <div class="phase">
          <h3><small>BEFORE</small>분쟁 전 설계</h3>
          <ul>
            <li><b>계약서 검토 · 동행</b><span>매매·전세·분양 계약 전 특약과 권리관계 점검</span><i>특약 · 권리관계 · 등기부 확인</i></li>
            <li><b>유언 · 사전 의향서</b><span>치매 전 재산 관리와 돌봄에 관한 뜻을 기록</span><i>유언장 · 임의후견 · 사전 의향서</i></li>
            <li><b>성년후견 · 증여 설계</b><span>후견인 지정, 사전 증여와 상속세 구조</span><i>세무사 · 회계사와 한 팀</i></li>
          </ul>
        </div>
        <div class="divider">그 사이에 변호사가 있습니다</div>
        <div class="phase">
          <h3><small>AFTER</small>분쟁 해결</h3>
          <ul>
            <li><b>보전처분</b><span>가압류·가처분으로 먼저 재산을 묶습니다</span><i>속도가 결과를 바꿉니다</i></li>
            <li><b>소송 · 조정</b><span>서면과 변론을 변호사가 직접 작성하고 출석합니다</span><i>사무장 상담 없음</i></li>
            <li><b>집행 · 회수</b><span>판결 뒤 실제로 돈과 집을 돌려받을 때까지</span><i>끝까지</i></li>
          </ul>
        </div>
      </div>
      <div class="story">
        <blockquote>"어머니 인감으로 몰래 아파트를 판 형제가 있었습니다. 변호사라면 후견인 지정 방법을 안내하면 될 일이었지만, 저는 미리 막을 방법을 만들고 싶었습니다."
          <cite>2019년, 로펌 근무 시절 만난 의뢰인 이야기 · 중앙일보 인터뷰(2024.7)에서</cite>
        </blockquote>
        <p>그 사연이 리걸테크 회사를 직접 세운 출발점이 되었습니다. 치매 전에 내 뜻을 남기는 서비스와 계약의 전 과정을 기록하는 화상 계약 서비스는 모두 "분쟁이 되기 전에"라는 한 가지 생각에서 나왔습니다. 지금은 법무법인 베율에서 변호사·세무사·회계사가 한 팀으로 분쟁 해결과 절세, 재산 승계를 함께 다룹니다.</p>
      </div>
    </div>
  </section>

  <!-- 변호사 소개 -->
  <section class="sec" id="about">
    <div class="wrap profile">
      {hasPhoto ? <img class="photo-img" src="/profile.jpg" alt="차형진 변호사 프로필 사진" width="800" height="1000" loading="lazy" /> : <div class="photo">프로필 사진<br />(public/profile.jpg 에 넣으면 표시됩니다)</div>}
      <div>
        <div class="gu">변호사 소개</div>
        <h2 style="margin-top:12px">차형진 변호사</h2>
        <p class="quote">"{bio.quote}"</p>
        <p class="bio">{bio.intro}</p>
        <div class="cv">
          <div><h4>학력</h4><ul>{bio.education.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>경력</h4><ul>{bio.career.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>활동</h4><ul>{bio.activity.map((x) => <li>{x}</li>)}</ul></div>
          <div><h4>수상 · 강의</h4><ul>{bio.awards.map((x) => <li>{x}</li>)}</ul></div>
        </div>
        <p style="margin-top:22px"><a class="btn btn-ghost" href="/about">소개 전체 보기</a></p>
      </div>
    </div>
  </section>

  <!-- 비용 -->
  <section class="sec band-paper" id="fees">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">비용 안내</div>
        <h2>비용은 상담에서 먼저 말씀드립니다</h2>
        <p>부동산과 상속 분쟁은 남은 전부를 걸고 싸우는 일입니다. 비용 구조를 모른 채 시작하지 않도록, 첫 상담에서 총 예상 비용을 숫자로 드립니다.</p>
      </div>
      <div class="principles">
        <div class="principle"><div class="num">원칙 하나</div><h3>총 예상 견적을 먼저</h3><p>사건의 종류와 난이도에 따라 예상되는 총비용과 기간을 상담 자리에서 제시합니다. 숨은 비용은 없습니다.</p></div>
        <div class="principle"><div class="num">원칙 둘</div><h3>사건에 맞는 구조로</h3><p>대부분의 소송은 착수금과 성공보수로 구성된 일반 수임 계약으로, 자문과 일부 사건은 수행 시간을 기준으로 월 상한을 정한 시간제로 진행합니다. 어느 쪽이 맞는지 상담에서 정합니다.</p></div>
        <div class="principle"><div class="num">원칙 셋</div><h3>변호사가 직접, 정해진 건수만</h3><p>상담과 서면, 변론을 변호사가 직접 합니다. 집중해서 다룰 수 있는 건수만 맡습니다.</p></div>
      </div>
      <p style="margin-top:22px"><a class="btn btn-ghost" href="/fees">비용 안내 자세히</a></p>
    </div>
  </section>

  <!-- 칼럼 -->
  <section class="sec" id="columns">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">칼럼 · 꿀팁</div>
        <h2>섣불리 결정하지 마세요. 글 세 개만 먼저 읽어보세요.</h2>
        <p>같은 상황을 겪은 분들의 질문에 답해 온 기록 {cols.length}편입니다. 사례는 의뢰인 동의를 받아 익명으로 소개합니다.</p>
      </div>
      <div class="posts">
        {homePosts.map((p) => (
          <a class={`post ${p!.section === '상속' ? 'in' : ''}`} href={postPath(p!)}>
            <span class="tag">{p!.section} · {fmtDate(p!.date)}</span>
            <h3>{p!.title}</h3>
            <p>{p!.excerpt}</p>
            <span class="read">읽기 →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/columns">칼럼 전체 보기</a></p>
    </div>
  </section>

  <!-- 언론 -->
  <section class="sec band-paper" id="press">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">언론 · 활동</div>
        <h2>기록으로 남은 활동</h2>
      </div>
      <div class="press-row">{pressOutlets.map((o) => <span>{o}</span>)}</div>
      <div class="grid3">
        {picks.map((p) => (
          <a class="press" href={p.url} target="_blank" rel="noopener">
            <span class="src">{p.outlet} · {p.date}</span>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/press">언론·활동 전체 보기</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <div class="gu">자주 묻는 질문</div>
        <h2>상담 전에 궁금한 것들</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- 상담 -->
  <section class="sec band-paper" id="contact">
    <div class="wrap contact">
      <div>
        <div class="gu">상담 예약</div>
        <h2 style="margin-top:12px">24시간 안에 변호사가 직접 연락드립니다</h2>
        <div class="ways">
          <a class="way" href={site.phoneHref}><span class="k">전화</span><span class="v">{site.phone}<small>{site.hours} · 변호사 직통</small></span></a>
          <div class="way"><span class="k">카카오톡</span><span class="v">채널 '{site.kakaoName}'<small>개설 준비 중 · 사진과 계약서를 바로 보내실 수 있습니다</small></span></div>
          <a class="way" href="/contact"><span class="k">온라인</span><span class="v">상담 신청서<small>상황을 적어 보내주시면 변호사가 검토 후 연락드립니다</small></span></a>
        </div>
        <div class="office">
          <b>{site.firm} · 삼성동</b>
          <span>{site.address}</span>
          <span>{site.transit} · {site.parking}</span>
          <span>{site.hours} · {site.closed}</span>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
