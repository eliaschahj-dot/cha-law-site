<script>
  // 맡는 일 항목: 한 묶음에서 하나만 펼친다. 주소에 #k-… 가 있으면 그 항목을 연다.
  const openItem = (it: Element | null) => {
    if (!it) return;
    const list = it.parentElement!;
    list.querySelectorAll('.kitem.open').forEach((x) => { x.classList.remove('open'); x.querySelector('.kbtn')?.setAttribute('aria-expanded', 'false'); });
    it.classList.add('open');
    it.querySelector('.kbtn')?.setAttribute('aria-expanded', 'true');
  };
  document.querySelectorAll('.kgroups').forEach((g) => {
    g.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('.kbtn');
      if (!b) return;
      const it = b.parentElement!;
      if (it.classList.contains('open')) { it.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); } else openItem(it);
    });
  });
  const byHash = () => { const h = location.hash.slice(1); if (h.startsWith('k-')) openItem(document.getElementById(h)); };
  byHash();
  window.addEventListener('hashchange', byHash);
</script>
