---
import Base from '../../layouts/Base.astro';
import AreaPage from '../../components/AreaPage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { byAxis } from '../../data/areas';

export function getStaticPaths() {
  return byAxis('re').map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: area.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title={`${area.name} | 부동산`} description={`${area.lead} ${area.short}. 부동산 전문 변호사 차형진.`} jsonLd={ld}>
  <AreaPage area={area} />
  <CtaBand area={area.name} />
</Base>
