---
/* 부동산 분야 페이지: /real-estate/{slug}. 원본 src/content/areas/re-*.json (axis: re) */
import Base from '../../layouts/Base.astro';
import AreaPage from '../../components/AreaPage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { reAreas } from '../../data/areas';
import { areaSeo } from '../../data/seo';

export function getStaticPaths() {
  return reAreas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
const { area } = Astro.props;
const seo = areaSeo[area.slug];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: area.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base variant="re" title={seo?.title ?? `${area.name} 변호사`} rawTitle={!!seo} description={seo?.desc ?? `${area.lead} ${area.short}. 부동산 전문 변호사 차형진이 직접 상담하고 수행합니다.`} jsonLd={ld} breadcrumbs={[{ name: '홈', href: '/real-estate' }, { name: '부동산 업무 분야', href: '/real-estate#fields' }, { name: area.name }]}>
  <AreaPage area={area} />
  <CtaBand area={area.name} contact="/real-estate/contact" />
</Base>
